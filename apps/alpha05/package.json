{
  "name": "@vaipakam/alpha05",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The next Vaipakam connected app, rebuilt from docs/FunctionalSpecs under docs/DesignsAndPlans/Alpha05AppDesign.md. Served on its own Worker until it reaches parity with apps/app, which keeps serving app.vaipakam.com until then (#3180).",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit && eslint . && node scripts/check-word-budget.mjs",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && node ../../packages/lib/bin/wrangler-deploy.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "copy:budget": "node scripts/check-word-budget.mjs",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.1",
    "@vaipakam/contracts": "workspace:*",
    "@vaipakam/i18n": "workspace:*",
    "@vaipakam/lib": "workspace:*",
    "connectkit": "^1.9.2",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.0",
    "viem": "^2.48.4",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vaipakam/anvil-harness": "workspace:*",
    "@vaipakam/e2e-wallet": "workspace:*",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.4",
    "wrangler": "^4.84.1"
  }
}
