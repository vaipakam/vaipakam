# app runtime configuration. Copy to .env.local and fill in.
# All contract addresses come from @vaipakam/contracts deployments.json —
# never from env.

# Per-chain RPC URLs (fall back to public endpoints when unset).
# VITE_ETHEREUM_RPC_URL also backs the ENS-read-only mainnet client
# (reverse-name display sugar) even while no Diamond is deployed on
# Ethereum — set it to a keyed endpoint to keep ENS lookups off the
# shared public ones.
VITE_BASE_SEPOLIA_RPC_URL=
VITE_ARBITRUM_SEPOLIA_RPC_URL=
VITE_BNB_TESTNET_RPC_URL=
VITE_ETHEREUM_RPC_URL=
VITE_BASE_RPC_URL=
VITE_ARBITRUM_RPC_URL=
VITE_OPTIMISM_RPC_URL=
VITE_BNB_RPC_URL=

# OPTIONAL per-chain WebSocket RPC URLs. When set, the live-update layer
# subscribes to new blocks (eth_subscribe) so transactions reflect in the
# UI near-instantly; when unset it falls back to HTTP block polling. Env
# key defaults to the RPC key with _RPC_URL -> _WSS_URL, shown here.
# (e.g. dRPC: swap https:// for wss:// on the same path.)
# One per chain that actually has a Diamond — Base Sepolia, Arbitrum
# Sepolia and BNB Testnet. The other five chains in CHAIN_META carry no
# deployment, so they never enter SUPPORTED_CHAINS and nothing
# subscribes on them; they need no entry here.
VITE_BASE_SEPOLIA_WSS_URL=
VITE_ARBITRUM_SEPOLIA_WSS_URL=
VITE_BNB_TESTNET_WSS_URL=

# Default chain for reads when disconnected/unsupported (chainId).
VITE_DEFAULT_CHAIN_ID=84532

# WalletConnect Cloud project id — WalletConnect pairing is disabled
# when unset (extension wallets still work).
VITE_WALLETCONNECT_PROJECT_ID=

# Indexer worker origin. When unset, list pages show an honest
# "couldn't load" state instead of fake-empty markets.
VITE_INDEXER_ORIGIN=https://indexer.vaipakam.com

# OPTIONAL override for the indexer's realtime push channel. Leave unset
# unless the WebSocket is fronted on a DIFFERENT host from the origin
# above: when empty, the ws origin is derived from VITE_INDEXER_ORIGIN by
# swapping the scheme (https -> wss), so realtime push already works
# without this. Set it only to point the socket somewhere else.
VITE_INDEXER_WS_ORIGIN=

# Alerts backend (apps/agent Worker origin). When unset, the Alerts
# card in Settings shows an honest "not set up in this build" message
# and fires no requests — never silently pointed at production.
VITE_AGENT_ORIGIN=

# Push Protocol channel address for the alerts deep link. When unset
# or not address-shaped, the Push rail is hidden.
VITE_PUSH_CHANNEL_ADDRESS=

# OPTIONAL override for the "report an issue" target in the diagnostics
# panel. Defaults to this repository's issue tracker.
#
# CONSTRAINED — this is a repo swap, not a free-form URL. The report is
# delivered as GitHub issue-form prefill: the builder appends
# `template=bug.yml` plus the `surface`, `chain`, `env` and `extra`
# FIELD IDS from this repo's bug form. So the target must be a GitHub
# `/issues/new` endpoint on a repository whose bug.yml declares those
# same ids — a fork or a private mirror. An arbitrary internal form
# receives parameters it does not understand and silently drops the
# diagnostics.
#
# It must also carry NO query string of its own: the builder appends
# `?` unconditionally, so a target ending in `?foo=bar` yields a
# malformed URL.
VITE_GITHUB_ISSUES_URL=

# ─────────────────────────────────────────────────────────────────────
# BUILD-ENVIRONMENT ONLY — this one is NOT read from .env.local.
#
# `prebuild` runs scripts/generate-seo.mjs before every build, and that
# script reads process.env DIRECTLY — it does not load this file or
# .env.local, because it is a plain Node script rather than part of the
# Vite pipeline. Setting it below has NO effect; it must be exported in
# the shell (or set in the CI/deploy environment) that runs the build:
#
#     VITE_APP_PUBLIC_ORIGIN=https://app.example.com pnpm run deploy
#
# It selects the origin for every URL in the generated sitemap and the
# robots.txt sitemap target. Unset, both are emitted against
# https://app.vaipakam.com — correct for the production deploy, wrong
# and silently so for any deployment served from another origin.
# Listed here for discoverability, NOT to be filled in below.
# ─────────────────────────────────────────────────────────────────────

# Operator kill switch: comma-separated write flows to disable
# (post-offer, accept-offer, nft-list, nft-rent, vpfi-deposit, or
# `all`). Only position-OPENING flows are switchable — repayments,
# claims, and withdrawals can never be disabled from here.
VITE_DISABLED_FLOWS=
