{
  "name": "@vaipakam/app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The Vaipakam connected app — app.vaipakam.com. Naive-user-first: intent-first guided flows, Basic/Advanced mode, light/dark theme, mobile-first. Replaced the retired apps/defi surface.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit && eslint . && node scripts/check-hardcoded-strings.mjs && node scripts/check-accept-errors.mjs && tsx scripts/check-locale-coverage.ts && tsx scripts/check-coverage-matrix.ts",
    "i18n:check": "node scripts/check-hardcoded-strings.mjs",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "deploy": "REQUIRE_INDEXER_ORIGIN=1 pnpm run build && node ../../packages/lib/bin/wrangler-deploy.mjs",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "i18n:template": "tsx scripts/export-i18n-template.ts",
    "test": "vitest run",
    "i18n:coverage": "tsx scripts/check-locale-coverage.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@vaipakam/contracts": "workspace:*",
    "@vaipakam/i18n": "workspace:*",
    "@vaipakam/lib": "workspace:*",
    "connectkit": "^1.9.2",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lightweight-charts": "^5",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "viem": "^2.57.13",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vaipakam/anvil-harness": "workspace:*",
    "@vitejs/plugin-react": "^6.0.1",
    "acorn": "^8.19.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-scope": "^8.4.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.4",
    "wrangler": "^4.156.0"
  }
}
