{
  // Vaipakam app Worker — Cloudflare Workers Static Assets deploy of the
  // apps/app Vite SPA build. Serves `app.vaipakam.com`, which IS BOUND:
  // the hostname resolves to this Worker and returns the build a
  // `pnpm run deploy` publishes. Deploy with `pnpm run deploy` (never a
  // bare build — see the guard note in vite.config.ts); a bare build
  // ships without operator env and only warns.
  //
  // The marketing site's links still resolve to the legacy host anyway.
  // That is now a DELIBERATE HOLD rather than a missing prerequisite —
  // `APP_TARGET` in apps/www/src/lib/appUrl.ts waits on the Vpfi deposit
  // anchor, and the recovery links wait on the legacy host actually
  // being retired. The checklist beside `APP_TARGET` is the authority.
  //
  // apps/app is THE connected app: the naive-user-first surface that
  // replaced the retired apps/defi (defi.vaipakam.com) in #1854. It was
  // developed as `apps/alpha02` on alpha02.vaipakam.com; the folder, the
  // package name and the Worker were renamed together at cutover so no
  // "alpha" naming survives on the surface users reach.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaipakam-app",
  "compatibility_date": "2026-04-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    // REQUIRED by wrangler v4 — without it `wrangler deploy` errors
    // ("missing the required `directory` property") on any clean
    // checkout. Vite's default outDir; run `pnpm run deploy` (build
    // first) so the directory exists.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
