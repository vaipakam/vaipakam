# systemd unit for the keeper machine runner (docs/ops/KeeperMachine.md).
#
# Install:
#   sudo install -d -m 755 /opt/vaipakam-keeper
#   sudo install -m 644 dist/keeper-machine.mjs /opt/vaipakam-keeper/
#   sudo install -d -m 750 /etc/vaipakam
#   sudo install -m 600 machine/.env.machine /etc/vaipakam/keeper.env
#   sudo install -m 644 machine/deploy/vaipakam-keeper.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vaipakam-keeper
# Logs: journalctl -u vaipakam-keeper -f
#
# Node 22 or later (`--env-file`); systemd 250 or later (`%d`). The env file
# stays root-only (0600): LoadCredential copies it into a private credentials
# directory readable by this service's dynamic user alone, so its mode never
# has to be loosened.

[Unit]
Description=Vaipakam keeper (machine runner)
Documentation=https://github.com/vaipakam/vaipakam/blob/main/docs/ops/KeeperMachine.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=keeper.env:/etc/vaipakam/keeper.env
ExecStart=/usr/bin/node --env-file=%d/keeper.env /opt/vaipakam-keeper/keeper-machine.mjs

# SIGTERM stops new ticks and lets the in-flight one finish (a pass may be
# waiting on a transaction receipt). Give it room before systemd escalates to
# SIGKILL, which WOULD cut a pass off mid-submission.
KillSignal=SIGTERM
TimeoutStopSec=300

# A start-up failure (missing variable, unreachable database) exits non-zero.
# Retry, but not in a tight loop.
Restart=always
RestartSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX: name resolution through systemd-resolved / nscd.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately NOT set: V8's JIT needs W+X pages.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
