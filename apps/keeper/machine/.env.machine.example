# Keeper machine runner: environment template.
#
# Copy to `.env.machine` (gitignored), fill it in, and keep it readable by the
# runner's user only (chmod 600). The runner reads it with
# `node --env-file=.env.machine dist/keeper-machine.mjs`. The systemd unit and
# the Dockerfile in machine/deploy/ pass it the same way.
#
# Names are the Worker's binding names, unchanged, so a value moves between
# the two hosts without renaming. Leaving a variable EMPTY or deleting it
# makes it absent, exactly as an unbound secret is on the Worker: the chain it
# serves drops out, or the pass it arms stays dark. Every tick logs
# `chains resolved: N — …`. Check that line, because a missing RPC shows up
# only as an absence.
#
# Full procedure: docs/ops/KeeperMachine.md.

# ── The machine's own database access (NOT part of the keeper env) ────────
# The keeper reaches the shared D1 database (`vaipakam-warm`) through
# Cloudflare's D1 HTTP API. Use a token scoped to D1 Edit on this account ONLY.
# Never reuse a deploy token: this one lives on the machine for as long as the
# runner does.
CLOUDFLARE_ACCOUNT_ID=
KEEPER_D1_API_TOKEN=
# Optional. It defaults to vaipakam-warm (e5e927cf-56c3-42c7-9820-179a235cc84f).
KEEPER_D1_DATABASE_ID=

# ── Arming. ALL OFF until the runbook says otherwise ───────────────────────
# `KEEPER_ENABLED` is the master gate for every fund-moving pass. Start at
# `false` and validate unarmed ticks first (runbook step 5).
KEEPER_ENABLED=false
# Double-gated passes: each also needs KEEPER_ENABLED=true.
# Arming graceDefault is its own owner decision. It sells or transfers
# collateral on past-grace loans.
GRACE_DEFAULT_ENABLED=
REWARD_REMIT_ENABLED=
REWARD_COMMIT_ENABLED=

# ── Secrets (Secrets Store bindings on the Worker) ─────────────────────────
# The ONE signing key. While a machine runs, it must not also be live on a
# scheduled Worker. See "One runner at a time" in the runbook.
KEEPER_PRIVATE_KEY=
# Per-chain RPC URLs. Set only the chains this deployment serves.
RPC_BASE=
RPC_ETH=
RPC_ARB=
RPC_OP=
RPC_BNB=
RPC_SEPOLIA=
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_OP_SEPOLIA=
RPC_BNB_TESTNET=
# The user-facing bot (NOT TG_OPS_BOT_TOKEN). See "Two Telegram bots" in CLAUDE.md.
TG_BOT_TOKEN=
PUSH_CHANNEL_PK=
ZEROEX_API_KEY=
ONEINCH_API_KEY=

# ── Plain knobs (`vars` on the Worker) ─────────────────────────────────────
# Copy the live values from the Worker's dashboard. Unset means the code's
# default, as on the Worker.
TG_BOT_USERNAME=
FRONTEND_ORIGIN=
REWARD_REMIT_LOOKBACK_DAYS=
REWARD_REMIT_LANE_CAP=
REWARD_COMMIT_LOOKBACK_DAYS=
LIQ_CONFIDENCE_MIN_CHECKS=
LIQ_CONFIDENCE_MIN_WINDOW_DAYS=
LIQ_TIER3_MIN_TVL_USD=
LIQ_TIER3_DISABLE_DEFI_LISTING=
LIQ_TIER3_MIN_MCAP_USD=
LIQ_TIER3_MIN_VOL_USD=
SPLIT_MIN_IMPROVEMENT_BPS=
PARTIAL_LIQ_MIN_HF_BPS=
