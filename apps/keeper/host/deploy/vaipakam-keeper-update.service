# Deploys the latest commit of the deploy branch (update.sh). Runs as root
# because it installs releases and restarts the keeper; the build itself runs
# in a throwaway sandbox as a fresh dynamic user (build.sh), which can read
# neither the keeper's env file nor its releases. A oneshot unit never runs
# twice at once, so two deploys cannot interleave.

[Unit]
Description=Vaipakam keeper: deploy the latest commit
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/vaipakam-keeper/update.sh
# A build on a small machine can take a while.
TimeoutStartSec=1800
