# Keeper on an always-on machine: environment template.
#
# install.sh copies this to /etc/vaipakam/keeper.env (root-only, 0600) the
# first time it runs, and never overwrites it after that. Fill that copy in on
# the machine itself. Never commit a filled-in copy, and never paste a value
# from it into chat or a ticket.
#
# Names are the Worker's binding names, unchanged, so a value moves between
# the two hosts without renaming. An EMPTY value means unset, exactly as an
# unbound secret or var is on the Worker: the chain it serves drops out, the
# pass it arms stays dark, or the knob takes the code's default. Every tick
# logs `[keeper] chains resolved: ...`; check that line, because a missing
# RPC shows up only as an absence.
#
# apps/keeper/test/hostDeploy.test.ts keeps this file in step with the settings the
# keeper reads. Full procedure: docs/ops/KeeperMachine.md.

# -- Database (machine only; a Worker gets this as a binding) ---------------
# The shared vaipakam-warm D1 database, reached over Cloudflare's D1 HTTP API.
# The token needs the account's D1 Edit permission and nothing else. Cloudflare
# cannot limit a token to one database, so this one can read and write every
# D1 database on the account. Keep it on this machine only.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=e5e927cf-56c3-42c7-9820-179a235cc84f
# The keeper's PRIVATE database (vaipakam-keeper-db, #2450) needs no setting:
# its id is pinned in the code, as the Worker's binding is. Until its migrations
# are applied, every tick declines and names them (docs/ops/KeeperMachine.md, 4a).
CLOUDFLARE_D1_API_TOKEN=

# -- One runner at a time --------------------------------------------------
# This machine's name for the one-runner lease (#2503). Each tick claims the
# lease in the shared database and declines while another runner (the Worker
# is "cloudflare-worker", or another machine) holds it. Left empty, it is
# host:<this machine's host name>; set it only if two machines could share a
# host name.
KEEPER_RUNNER_ID=

# -- Arming. Leave all of these off until the runbook says otherwise --------
# KEEPER_ENABLED is the master gate for every fund-moving pass. Arming it, and
# each per-pass flag below, is a separate owner decision.
KEEPER_ENABLED=false
GRACE_DEFAULT_ENABLED=
PERIODIC_SETTLE_ENABLED=
REWARD_CLOSE_OUT_ENABLED=
REWARD_REMIT_ENABLED=
REWARD_COMMIT_ENABLED=
REWARD_DELIVERY_PROOF_ENABLED=
REWARD_SANCTIONS_KEEPER_ENABLED=
REWARD_HORIZON_HEARTBEAT_ENABLED=
REWARD_DAY_CLOSE_ENABLED=
# The flash-loan discount path (#2633): a comma list of chain ids, e.g. 8453.
# A chain also needs its FlashLoanLiquidator deployed; none is yet, so this
# arms nothing today. docs/ops/FlashLoanLiquidatorRollout.md, Step 5.
DISCOUNT_PATH_CHAIN_IDS=

# -- Secrets (Secrets Store bindings on the Worker) -------------------------
# The ONE keeper signing key. Only one keeper may run with it at a time: see
# "One keeper at a time" in the runbook.
KEEPER_PRIVATE_KEY=
# Per-chain RPC URLs. Set only the chains this deployment serves (today Base
# Sepolia and Arbitrum Sepolia).
RPC_BASE=
RPC_ETH=
RPC_ARB=
RPC_OP=
RPC_BNB=
RPC_SEPOLIA=
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_OP_SEPOLIA=
RPC_BNB_TESTNET=
# The user-facing Telegram bot (never TG_OPS_BOT_TOKEN).
TG_BOT_TOKEN=
# The OPS bot and its one operator chat, for the reward passes' operator
# alerts (#2450). Never the user-facing bot above.
TG_OPS_BOT_TOKEN=
TG_OPS_CHAT_ID=
PUSH_CHANNEL_PK=
ZEROEX_API_KEY=
ONEINCH_API_KEY=

# -- Plain knobs (vars on the Worker) ---------------------------------------
# Copy the live values from the keeper Worker's dashboard. Empty means the
# code's default.
TG_BOT_USERNAME=
FRONTEND_ORIGIN=
# The Push channel posted as (#1456). Empty = the PUSH_CHANNEL_PK signer's
# own address; another address = post as a delegate of that channel.
PUSH_CHANNEL_ADDRESS=
REWARD_REMIT_LOOKBACK_DAYS=
REWARD_REMIT_LANE_CAP=
# Smallest part (wei) that may leave its day owing (#2960). Empty = 1000e18.
REWARD_REMIT_MIN_PART=
REWARD_COMMIT_LOOKBACK_DAYS=
# Days back the close-out pass looks for unproven days (#2984). Empty = 60.
REWARD_CLOSE_OUT_LOOKBACK_DAYS=
# Day-close CCIP fee ceiling per send (#2627): <chainId>=<wei>,... and an
# optional *=<wei>. Empty = 2000000000000000 wei (0.002 native) everywhere.
REWARD_DAY_CLOSE_MAX_FEE_WEI=
LIQ_CONFIDENCE_MIN_CHECKS=
LIQ_CONFIDENCE_MIN_WINDOW_DAYS=
LIQ_TIER3_MIN_TVL_USD=
LIQ_TIER3_DISABLE_DEFI_LISTING=
LIQ_TIER3_MIN_MCAP_USD=
LIQ_TIER3_MIN_VOL_USD=
SPLIT_MIN_IMPROVEMENT_BPS=
PARTIAL_LIQ_MIN_HF_BPS=
