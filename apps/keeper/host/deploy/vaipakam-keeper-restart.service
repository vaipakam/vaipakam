# Restarts the keeper onto the newly staged build. try-restart leaves a
# keeper that an operator has stopped stopped. The restart is graceful: the
# tick in flight finishes first (TimeoutStopSec in vaipakam-keeper.service).

[Unit]
Description=Vaipakam keeper: restart onto the staged build

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl try-restart vaipakam-keeper.service
