# The failed transaction pass (apps/failed-tx-pass/README.md).
# /etc/vaipakam/failed-tx.env, root-only (0600). An empty value means unset.

# The indexer, and the writer token. The same token is the indexer Worker's
# FAILED_TX_WRITER_TOKEN secret; nothing else holds it.
INDEXER_ORIGIN=https://indexer.vaipakam.com
FAILED_TX_WRITER_TOKEN=

# Networks to run (chain ids). Each needs its node endpoint below and a node
# capability result (ops/node-capability/results/<slug>.json, #3913).
FAILED_TX_CHAINS=84532,421614,97

# Node endpoints, by the deployment record's slug. Keyed endpoints: the mode
# and the reach of each source were measured on these.
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_BNB_TESTNET=

# One Etherscan v2 key, for the networks in list-and-audit mode. Without it
# those networks run sends-and-audit, and the health route states the share
# of the day that is watched.
EXPLORER_API_KEY=
# EXPLORER_API_BASE=https://api.etherscan.io/v2/api

# Optional: the operator chat (the ops bot, never the user bot).
TG_OPS_BOT_TOKEN=
TG_OPS_CHAT_ID=
