{
  // Vaipakam read-only RPC proxy (#1724).
  //
  // The connected app's per-chain RPC URLs used to ship in the browser
  // bundle, key and all. This Worker holds each chain's provider URL as a
  // secret and forwards only the reads the app makes, so the bundle carries
  // this Worker's origin instead of a key. What it forwards is stated once
  // in packages/lib/src/rpcProxyPolicy.ts; the README says what it does and
  // does not protect.
  //
  // DEPLOYED ON MERGE. Since 2026-11-04 this Worker has its own Workers
  // Build: a merge to main touching apps/rpc-proxy/ or packages/lib/ deploys
  // it. The connected app's production build reads through it
  // (VITE_RPC_PROXY_ORIGIN); a build without that variable keeps its own RPC
  // configuration. State and steps: README, "Turning it on".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaipakam-rpc-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",

  // Dashboard-managed vars survive a deploy: see the same block in
  // apps/agent/wrangler.jsonc for why every Worker in this tree declares it.
  "keep_vars": true,

  // Per-caller budget, keyed by client IP through @vaipakam/lib/rateLimit
  // (the one limiter rule every Worker shares). One slot per HTTP request,
  // and a request carries at most RPC_PROXY_MAX_BATCH calls. Sized for an
  // app tab (a list page's first paint is a few batched requests, then a
  // block poll every few seconds), several tabs, and a few people behind
  // one address. Cloudflare counts it per location, so it bounds what one
  // address spends, not what a crowd of addresses spends: the provider
  // plan's own cap is the outer bound (README).
  // namespace_id values are unique per account; 3001 is this Worker's.
  "unsafe": {
    "bindings": [
      {
        "name": "RPC_CALLER_RATELIMIT",
        "type": "ratelimit",
        "namespace_id": "3001",
        "simple": { "limit": 300, "period": 60 },
      },
      // Per-caller CALL budget (#1283), keyed the same way. The request
      // budget above counts HTTP requests, so a batch of fifty log scans
      // cost what one block poll did. This one is charged by the weight of
      // the calls a request forwards (packages/lib/src/rpcProxyPolicy.ts,
      // rpcCallWeight): one slot per RPC_PROXY_UNITS_PER_SLOT units, at
      // least one. A block poll every few seconds takes about 15 slots a
      // minute, a list page's batched reads a few each, and the widest batch
      // the proxy accepts (fifty log scans) 20. 3002 is this Worker's second
      // namespace.
      {
        "name": "RPC_CALL_RATELIMIT",
        "type": "ratelimit",
        "namespace_id": "3002",
        "simple": { "limit": 200, "period": 60 },
      },
    ],
  },

  // The upstream provider URLs, one per chain, from the account Secrets
  // Store. DEDICATED entries: never the keeper's or indexer's RPC_* ones,
  // so browser traffic cannot spend the quota the keeper needs to act on a
  // loan in time. A chain whose secret is absent or empty is reported as
  // not configured; nothing falls back to another chain's key.
  // Testnet chains only, for now. wrangler refuses a deploy whose binding
  // names a secret the store does not hold, and the mainnet keys are created
  // with Workers Paid at mainnet (#1724). Until then a mainnet chain id
  // answers 503 chain-not-configured, and the app falls back to that chain's
  // public endpoint. Add each mainnet entry back (same name for binding and
  // secret) once its key exists.
  "secrets_store_secrets": [
    {
      // Base Sepolia (84532)
      "binding": "RPC_PROXY_BASE_SEPOLIA",
      "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e",
      "secret_name": "RPC_PROXY_BASE_SEPOLIA",
    },
    {
      // Arbitrum Sepolia (421614)
      "binding": "RPC_PROXY_ARB_SEPOLIA",
      "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e",
      "secret_name": "RPC_PROXY_ARB_SEPOLIA",
    },
    {
      // BNB Testnet (97)
      "binding": "RPC_PROXY_BNB_TESTNET",
      "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e",
      "secret_name": "RPC_PROXY_BNB_TESTNET",
    },
  ],

  // The proxy's hostname, declared here so a deploy keeps it bound (the
  // indexer's pattern). Attached 2026-11-04; the connected app reads
  // through it (VITE_RPC_PROXY_ORIGIN=https://rpc.vaipakam.com).
  "routes": [
    {
      "pattern": "rpc.vaipakam.com",
      "custom_domain": true,
    },
  ],

  "vars": {
    // Exact origins whose pages may call this proxy (CSV). The connected
    // app's production and workers.dev hosts, and the same pair for the next
    // connected app, apps/alpha05 (#3180), which reads through this proxy
    // from its own hostname until the cutover. An Origin check only stops
    // other sites' pages; a script can send any Origin, which is what the
    // rate limit above is for.
    "FRONTEND_ORIGIN": "https://app.vaipakam.com,https://vaipakam-app.dawn-fire-139e.workers.dev,https://alpha05.vaipakam.com,https://vaipakam-alpha05.dawn-fire-139e.workers.dev",
  },

  "observability": {
    "enabled": true,
  },
}
