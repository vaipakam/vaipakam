{
  "name": "@vaipakam/alpha02",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Naive-user-first redesign of the Vaipakam connected app \u2014 alpha02.vaipakam.com. Intent-first guided flows, Basic/Advanced mode, light/dark theme, mobile-first.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit && eslint . && node scripts/check-hardcoded-strings.mjs && tsx scripts/check-locale-coverage.ts",
    "i18n:check": "node scripts/check-hardcoded-strings.mjs",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "deploy": "REQUIRE_INDEXER_ORIGIN=1 pnpm run build && wrangler deploy",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "i18n:template": "tsx scripts/export-i18n-template.ts",
    "test": "vitest run",
    "i18n:coverage": "tsx scripts/check-locale-coverage.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vaipakam/contracts": "workspace:*",
    "@vaipakam/i18n": "workspace:*",
    "@vaipakam/lib": "workspace:*",
    "connectkit": "^1.9.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.11",
    "lightweight-charts": "^5",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "viem": "^2.55.10",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tsx": "^4.23.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
