  "dynamicSites": [
    {
      "path": "script/lib/Signers.sol",
      "patterns": [
        "*_ADDRESS",
        "*_PRIVATE_KEY"
      ],
      "reason": "<ROLE>_ADDRESS and <ROLE>_PRIVATE_KEY for each signing role."
    },
    {
      "path": "script/lib/ArtifactRoot.sol",
      "patterns": [
        "VAIPAKAM_REHEARSAL*"
      ],
      "reason": "The rehearsal flag and scratch root, through named constants."
    },
    {
      "path": "script/lib/EnvFlag.sol",
      "patterns": [
        "*"
      ],
      "reason": "A generic boolean-flag reader; each caller passes a literal name, which the literal check covers."
    },
    {
      "path": "script/lib/Deployments.sol",
      "patterns": [
        "*_*"
      ],
      "reason": "Chain-prefixed variants (<CHAIN>_<KEY>) of keys the callers pass literally."
    },
    {
      "path": "script/lib/PriceGuardDeployment.sol",
      "patterns": [
        "*_FEED",
        "*_*"
      ],
      "reason": "Per-symbol stable feeds (<SYMBOL>_FEED) and chain-prefixed variants."
    },
    {
      "path": "script/ConfigureOracle.s.sol",
      "patterns": [
        "*_*"
      ],
      "reason": "Chain-prefixed oracle settings (<CHAIN>_PAA_QUOTE_ASSETS and the like)."
    },
    {
      "path": "script/ConfigureVPFIBuy.s.sol",
      "patterns": [
        "*"
      ],
      "reason": "Keys passed in by the caller, chain-prefixed or bare."
    },
    {
      "path": "script/ConfigureVPFIToken.s.sol",
      "patterns": [
        "*_*"
      ],
      "reason": "Chain-prefixed variants of literal keys."
    },
    {
      "path": "script/DeployFlashLoanLiquidator.s.sol",
      "patterns": [
        "*"
      ],
      "reason": "Keys passed in by the caller."
    },
    {
      "path": "script/DeployUniV3Adapter.s.sol",
      "patterns": [
        "*_*"
      ],
      "reason": "Chain-prefixed variants of literal keys."
    },
    {
      "path": "script/Handover.s.sol",
      "patterns": [
        "*"
      ],
      "reason": "The bot-holder variables named in the handover plan."
    },
    {
      "path": "script/HandoverGate.s.sol",
      "patterns": [
        "*"
      ],
      "reason": "The bot-holder variables named in the handover plan."
    }
  ],
  "leftOut": [
    {
      "pattern": "*PRIVATE_KEY",
      "reason": "Signing keys: a rehearsal holds none and pins them to zero (design section 18, kind 1)."
    },
    {
      "pattern": "*_RPC_URL",
      "reason": "RPC endpoints: a rehearsal reaches a fork, the real deploy the chain; the chain id is checked instead (kind 2)."
    },
    {
      "pattern": "*_RPC_URLS",
      "reason": "RPC endpoint lists, as above (kind 2)."
    },
    {
      "pattern": "VAIPAKAM_REHEARSAL*",
      "reason": "The rehearsal's own flag, scratch root and fork URL: declared differences (kind 3)."
    },
    {
      "pattern": "FOUNDRY_BROADCAST",
      "reason": "Forge's journal folder, moved to scratch in a rehearsal: a declared difference (kind 3)."
    },
    {
      "pattern": "FOUNDRY_CACHE_PATH",
      "reason": "Forge's run cache folder, moved with the journal folder: a declared difference (kind 3)."
    },
    {
      "pattern": "E2E_*",
      "reason": "Scenario-harness redirects, read only by the e2e wrappers, which never run in a deploy plan."
    },
    {
      "pattern": "*_API_KEY",
      "reason": "Provider and explorer credentials: they authenticate a request and change nothing that is deployed."
    },
    {
      "pattern": "*_API_TOKEN",
      "reason": "Provider credentials (Cloudflare), as above; the Cloudflare phases never run in a rehearsal."
    },
    {
      "pattern": "VAIPAKAM_LIVE_PUBLICATION_TOKEN",
      "reason": "A per-run lock token the deploy script itself creates for the archive manifest; never operator input."
    },
    {
      "pattern": "CHAIN_SLUG",
      "reason": "Set per command by the deploy script from its argument; the chain set is digested separately in the verdict."
    },
    {
      "pattern": "REPRICE_*",
      "reason": "Inputs of the hand-run testnet mock repricer, which is not a deploy step."
    },
    {
      "pattern": "FINALIZE_*",
      "reason": "Inputs of the hand-run reward day finalizer, which is not a deploy step."
    },
    {
      "pattern": "CENSUS_*",
      "reason": "Inputs of the read-only census report, which writes nothing on chain."
    },
    {
      "pattern": "EXPECT_CHANGED",
      "reason": "An assertion input of the changed-facet refresh, which is an in-place refresh (#3897), not a fresh-deploy step."
    }
  ],
  "hashedPatterns": [
    {
      "pattern": "*_ADDRESS",
      "reason": "Role and bot addresses: Signers.sol builds <ROLE>_ADDRESS from the role name, Handover reads the bot holders' names from a list."
    },
    {
      "pattern": "*_FEED",
      "reason": "Per-symbol price feeds: PriceGuardDeployment builds <SYMBOL>_FEED from VPFI_STABLE_FEED_SYMBOLS."
    },
    {
      "pattern": "*_GAS_PRICE_WEI",
      "reason": "Per-chain gas pins: the deploy wrappers build <SLUG>_GAS_PRICE_WEI and <SLUG>_PRIORITY_GAS_PRICE_WEI and export them as ETH_GAS_PRICE / ETH_PRIORITY_GAS_PRICE."
    }
  ],
  "chainPrefixes": [
    "ANVIL_",
    "ARBITRUM_",
    "ARB_SEPOLIA_",
    "BASE_",
    "BASE_SEPOLIA_",
    "BNB_",
