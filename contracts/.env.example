# is absent.
BASE_SEPOLIA_DIAMOND_ADDRESS=
SEPOLIA_DIAMOND_ADDRESS=
BNB_TESTNET_DIAMOND_ADDRESS=
ARB_SEPOLIA_DIAMOND_ADDRESS=
OP_SEPOLIA_DIAMOND_ADDRESS=
POLYGON_AMOY_DIAMOND_ADDRESS=

# VPFI deploy config (canonical Base Sepolia / mirror on other chains).
VPFI_OWNER=0xb985F8987720C6d76f02909890AA21C11bC6EBCA
VPFI_TREASURY=0xca3E735C593088D2f5ea5AEAa553a6bDaa6E7413
VPFI_INITIAL_MINTER=0xb985F8987720C6d76f02909890AA21C11bC6EBCA

# ============================================================
# Cross-chain transport — Chainlink CCIP (T-068). There is no LayerZero
# endpoint here any more, and no DVN policy to choose: CCIP's committing
# DON, executing DON and independent Risk Management Network are uniform
# for every integrator.
#
# Addresses come from Chainlink's published CCIP directory for the
# network you are deploying to — never hand-typed from another chain's
# stanza.
#
# **Use the PER-SLUG names.** The Forge scripts read a bare `CCIP_ROUTER`
# / `CCIP_RMN_PROXY`, but you do not set those: `deploy-chain.sh` resolves
# `CCIP_ROUTER_<SLUG>` for the chain being deployed and exports the bare
# name itself. A bare `CCIP_ROUTER` set by hand with no matching
# `CCIP_ROUTER_<SLUG>` is a **hard error**, deliberately — it is how you
# wire one chain's router into another chain's deploy. One set per slug,
# as in CcipCutoverRunbook.md.
# ------------------------------------------------------------
# DeployCrosschain.s.sol — REQUIRED per chain, no default.
CCIP_ROUTER_BASE_SEPOLIA=
CCIP_RMN_PROXY_BASE_SEPOLIA=
CCIP_ROUTER_SEPOLIA=
CCIP_RMN_PROXY_SEPOLIA=
CCIP_ROUTER_ARB_SEPOLIA=
CCIP_RMN_PROXY_ARB_SEPOLIA=
CCIP_ROUTER_OP_SEPOLIA=
CCIP_RMN_PROXY_OP_SEPOLIA=
CCIP_ROUTER_POLYGON_AMOY=
CCIP_RMN_PROXY_POLYGON_AMOY=
CCIP_ROUTER_BNB_TESTNET=
CCIP_RMN_PROXY_BNB_TESTNET=
# Mainnet slugs follow the same shape: CCIP_ROUTER_BASE,
# CCIP_ROUTER_ARBITRUM, CCIP_ROUTER_OPTIMISM, CCIP_ROUTER_POLYGON, …
#
# ConfigureCcip.s.sol — REQUIRED, no default. The CCT registration path.
# Per-slug as well: the wrappers resolve all FOUR CCIP_* names the same
# way, and reject a bare one whose per-slug counterpart is missing.
CCIP_TOKEN_ADMIN_REGISTRY_BASE_SEPOLIA=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_BASE_SEPOLIA=
CCIP_TOKEN_ADMIN_REGISTRY_SEPOLIA=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_SEPOLIA=
CCIP_TOKEN_ADMIN_REGISTRY_ARB_SEPOLIA=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_ARB_SEPOLIA=
CCIP_TOKEN_ADMIN_REGISTRY_OP_SEPOLIA=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_OP_SEPOLIA=
CCIP_TOKEN_ADMIN_REGISTRY_POLYGON_AMOY=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_POLYGON_AMOY=
CCIP_TOKEN_ADMIN_REGISTRY_BNB_TESTNET=
CCIP_REGISTRY_MODULE_OWNER_CUSTOM_BNB_TESTNET=
# Comma-separated EVM chain ids of every lane this chain talks on.
# Run `--phase ccip-wire` only after the contracts phase has landed on
# EVERY chain in this list — it reads each one's addresses.json.
CCIP_LANE_CHAIN_IDS=
# Guardian that can pause both directions of the cross-chain path.
# Refuses to run without it on the mainnet path (#855).
CCIP_GUARDIAN=
# Optional, with defaults. Per-lane VPFI TokenPool rate limits are set
# through the bounds-checked VpfiPoolRateGovernor, which refuses to
# disable a lane's limit outright (ET-008).
CCIP_DEST_GAS_LIMIT=400000
CCIP_RATE_CAPACITY=50000000000000000000000
CCIP_RATE_REFILL=5800000000000000000

# VPFI canonical stack on Base Sepolia (populated by DeployVPFICanonical.s.sol).
BASE_SEPOLIA_VPFI_TOKEN_IMPL=0x08de67696efeeb57bC6187e92371715a03cD4E12
BASE_SEPOLIA_VPFI_TOKEN=0x0D16d09e32515455956b85AAF7978755E8803720

# VPFI mirror on Sepolia (populated by DeployVPFIMirror.s.sol).
SEPOLIA_VPFI_MIRROR_IMPL=0xC123eb93A716838BC134cCFC01815e4B91F4f1C1
SEPOLIA_VPFI_MIRROR=0x7224DAC2d6837207D23127a34d84A2b6572D4fd8

# VPFI mirror on Arbitrum Sepolia (populated by DeployVPFIMirror.s.sol).
ARB_SEPOLIA_VPFI_MIRROR_IMPL=0x86D3200b6B29fdb9ea6d8d06748bBC9eCE3e87ce
ARB_SEPOLIA_VPFI_MIRROR=0xce30C660949c7A421d459A3C283dbD682b9f79fF

# VPFI mirror on OP Sepolia (populated by DeployVPFIMirror.s.sol).
OP_SEPOLIA_VPFI_MIRROR_IMPL=0x86D3200b6B29fdb9ea6d8d06748bBC9eCE3e87ce
OP_SEPOLIA_VPFI_MIRROR=0xce30C660949c7A421d459A3C283dbD682b9f79fF

# VPFI mirror on Polygon Amoy (populated by DeployVPFIMirror.s.sol).
POLYGON_AMOY_VPFI_MIRROR_IMPL=0x86D3200b6B29fdb9ea6d8d06748bBC9eCE3e87ce
POLYGON_AMOY_VPFI_MIRROR=0xce30C660949c7A421d459A3C283dbD682b9f79fF

# VPFI mirror on BNB Smart Chain Testnet (populated by DeployVPFIMirror.s.sol).
BNB_TESTNET_VPFI_MIRROR_IMPL=
BNB_TESTNET_VPFI_MIRROR=

# NOTE — the LayerZero peer setter (WireVPFIPeers.s.sol) and the whole
# fixed-rate VPFI buy stack (DeployVPFIBuyReceiver.s.sol /
# DeployVPFIBuyAdapter.s.sol, with their receiver, adapter, executor-
# options, refund-timeout and per-chain payment-token variables) used to
# sit here. Every one of those scripts is deleted: the buy surface was
# removed in #687-A, and peer wiring is CCIP's job, done by
# ConfigureCcip.s.sol from addresses.json. Nothing reads any of those
# variables. If you are carrying an older .env, delete them rather than
# filling them in.

# ============================================================
# ConfigureVPFIBuy.s.sol — VPFI fee-DISCOUNT price config. Run on EVERY
# chain, not just Base.
#
# Despite the script's name (kept so existing callers and spells still
# resolve), there is no sale here: #687-A removed the issuer fixed-rate
# surface along with its rate cap, per-wallet cap and enable flag. What
# remains is the consumptive fee-discount utility, which needs a VPFI
# price anchor and a per-chain ETH reference asset. Miss either on a
# chain and the discount silently no-ops there.
# ------------------------------------------------------------
# Price anchor for discount math: 1 VPFI = 0.001 ETH → 1e15 wei per VPFI.
# Global rate — the same value on every chain.
VPFI_BUY_WEI_PER_VPFI=1000000000000000
# Asset whose Diamond-internal ETH price is used for VPFI discount math.
# Required per chain (the canonical WETH on that network).
# On Base Sepolia this is WETH.
BASE_SEPOLIA_VPFI_DISCOUNT_ETH_PRICE_ASSET=0x4200000000000000000000000000000000000006

# ============================================================
# ConfigureOracle.s.sol — per-chain wiring of feeds, factory, 0x.
# Each var is resolved as <CHAIN>_<KEY>; missing keys fall back to the
# bare <KEY>. Common values shown for Base Sepolia.
# ------------------------------------------------------------
# WETH contract (Base Sepolia canonical WETH).
BASE_SEPOLIA_WETH_ADDRESS=0x4200000000000000000000000000000000000006
# Uniswap v3 factory (Base Sepolia).
BASE_SEPOLIA_UNISWAP_V3_FACTORY=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
# Chainlink ETH/USD feed (Base Sepolia).
BASE_SEPOLIA_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1
# Chainlink Denominations library sentinels (chain-agnostic).
BASE_SEPOLIA_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
BASE_SEPOLIA_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
SEPOLIA_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
SEPOLIA_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
ARB_SEPOLIA_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
ARB_SEPOLIA_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
OP_SEPOLIA_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
OP_SEPOLIA_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
POLYGON_AMOY_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
POLYGON_AMOY_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
# BNB testnet (97) oracle config. Numeraire = bridged-WETH9 + ETH/USD (the
# canonical pattern setWethContract mandates — NEVER WBNB; the pool-depth leg
# assumes ETH-denominated value). BSC testnet has no canonical bridged-ETH, so
# WETH_ADDRESS is a deployed 18-dec mock stand-in (mainnet uses the real
# bridged-ETH 0x2170Ed0880ac9A755fd29B2688956BD959F933F8). All others verified
# on-chain.
#
# CAVEAT (BNB testnet only): the mock stand-in is UNPAIRED — it has no PancakeSwap
# pool. With no Feed Registry on BNB and no PAA override, OracleFacet only
# special-cases the mock itself as liquid (asset == wethContract, priced off the
# ETH feed); real assets quoted against the actual WBNB (0xae13d989…) pools
# fail-closed as Illiquid, so this config does NOT make ordinary BNB-testnet
# assets tradeable. That's an accepted mirror-chain/testnet limitation — lifecycle
# rehearsals deploy their own paired mock markets. On MAINNET the real bridged-ETH
# has deep pools, so no stand-in and no caveat.
BNB_TESTNET_WETH_ADDRESS=0x6D874ff9a55517c61cECE2936B8F457a3ad9102d
BNB_TESTNET_ETH_USD_FEED=0x143db3CEEfbdfe5631aDD3E50f7614B6ba708BA7
BNB_TESTNET_UNISWAP_V3_FACTORY=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
# PancakeSwap V3 SwapRouter (UniV3-compatible exactInputSingle) — the
# UniV3Adapter target for HF-liquidation swaps (0x has no BNB-testnet backend).
BNB_TESTNET_UNISWAP_V3_ROUTER=0x1b81D678ffb9C0263b24A97847620C99d213eB14
BNB_TESTNET_USD_DENOMINATOR=0x0000000000000000000000000000000000000348
BNB_TESTNET_ETH_DENOMINATOR=0x000000000000000000000000000000000000eEeE
# BNB_TESTNET_ZEROX_PROXY intentionally UNSET — 0x's Swap API covers BNB
# mainnet (56) but not the testnet. ConfigureOracle skips 0x when a swap
# adapter is registered (run DeployUniV3Adapter.s.sol first).
# L2 sequencer uptime feed (Base Sepolia). Leave unset on L1 testnets.
BASE_SEPOLIA_SEQUENCER_UPTIME_FEED=0xBCF85224fc0756B9Fa45aA7892530B47e10b6433
# 0x Exchange Proxy and its allowance target (HF-based liquidation path).
# Look up current deployment at https://0x.org/docs/introduction/0x-cheat-sheet
BASE_SEPOLIA_ZEROX_PROXY=
BASE_SEPOLIA_ZEROX_ALLOWANCE_TARGET=
# Mainnet-only Chainlink Feed Registry — leave blank on testnets/L2s.
MAINNET_CHAINLINK_REGISTRY=0x47Fb2585D2C56Fe188D0E6ec628a38b74fCeeeDf
# Optional stable-token feed registration. Comma-separated symbols.
# Per symbol set <CHAIN>_<SYMBOL>_FEED.
VPFI_STABLE_FEED_SYMBOLS=USDC
BASE_SEPOLIA_USDC_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165

# ============================================================
# ConfigureRewardReporter.s.sol — cross-chain reward plumbing.
# Run per chain. Canonical (Base) also wires the aggregator's expected
# source chain ids.
#
# Chains are keyed by EVM chain id, NOT by an endpoint id — the reward
# flow identifies a chain by `block.chainid` and leaves selector
# translation to the CCIP messenger. There is no eid anywhere in this
# stack; if you are copying an older .env, drop LOCAL_EID / BASE_EID /
# REWARD_EXPECTED_SOURCE_EIDS entirely rather than translating them.
# ------------------------------------------------------------
# Reward messenger proxy — OPTIONAL, and best left unset.
#
# It is NOT the same address on every chain, whatever older docs say:
# `DeployCrosschain.s.sol` creates the impl and proxy with a plain `new`,
# there is no CREATE2 and no salt, and the committed artifacts hold a
# different address per chain. So "populate once, reuse everywhere" is
# exactly wrong — a single value carried across chains makes the
# env/artifact agreement check abort. When unset, the script reads the
# right address from that chain's addresses.json, which is what you want.
REWARD_MESSENGER_PROXY=
# EVM chain id of Base (the canonical reward chain). REQUIRED on mirror
# chains — and deliberately LEFT UNSET here.
#
# Do not pre-fill it. `deploy-mainnet.sh` only forces the value to 8453
# inside its configure phase; the earlier `--phase contracts` and
# `--phase ccip-wire` consume whatever the environment holds. A template
# that shipped 84532 would sail through the mirror-chain preflight (which
# checks only that it is SET) and wire a MAINNET mirror to the Base
# Sepolia reward hub, leaving its Base-directed paths unusable. Unset, the
# preflight stops and makes the operator choose.
#
# Base Sepolia = 84532, Base mainnet = 8453.
BASE_CHAIN_ID=
# Grace period (seconds) between closeDay and accept-global-report. Default 4h.
REWARD_GRACE_SECONDS=14400
# Comma-separated EVM chain ids of every chain the aggregator expects a
# daily report from. Only read when running on the canonical chain.
#
# **Include Base itself.** It is a source too — the facet treats this as
# the FULL replacement list and sums only the ids in it, so omitting
# 84532 drops Base's own daily interest out of the global denominator,
# and omitting a live mirror makes its reports arrive from an unknown
# source. List every chain in the mesh, canonical included.
# 84532 Base Sepolia (canonical) · 11155111 Sepolia · 421614 Arb Sepolia
# · 11155420 OP Sepolia · 80002 Polygon Amoy · 97 BNB Testnet
REWARD_EXPECTED_SOURCE_CHAIN_IDS=84532,11155111,421614,11155420,80002,97

# NOTE — REWARD_VERSION is gone. It described a CREATE2 bootstrap that
# gave the reward proxy the same address on every chain. That deploy path
# no longer exists: DeployCrosschain.s.sol uses a plain `new`, no script
# reads the variable, and the committed artifacts hold a different
# messenger address per chain. Setting it does nothing.

# ============================================================
# SetInteractionLaunch.s.sol — day-0 anchor, SAME on every chain.
# ------------------------------------------------------------
INTERACTION_LAUNCH_TIMESTAMP=
# Optional per-loan cap on VPFI/ETH (1e18-scaled). Leave 0 to skip.
INTERACTION_CAP_VPFI_PER_ETH=0

# ============================================================
# Diamond address for scripts that take it directly rather than reading
# addresses.json. (The DeployRewardOAppCreate2.s.sol block that used to
# own this section is gone with the script — its REWARD_OWNER /
# IS_CANONICAL_REWARD / LZ_ENDPOINT / *_OPTIONS_HEX variables are read by
# nothing. It also re-assigned REWARD_VERSION, silently overriding the
# value set above — which mattered while the reward proxy was still
# CREATE2-addressed off it. Both assignments are now gone along with the
# variable itself.)
# ------------------------------------------------------------
DIAMOND_ADDRESS=

# ============================================================
# DeployTimelock.s.sol / TransferAdminToTimelock.s.sol
# ------------------------------------------------------------
# Multi-sig (Gnosis Safe) that is allowed to schedule + cancel
# timelocked operations on the Diamond. Same address is used as
# EXECUTOR by default; set TIMELOCK_EXECUTOR=0x00...00 to allow
# anyone to execute once the delay elapses.
TIMELOCK_PROPOSER=
TIMELOCK_EXECUTOR=0x0000000000000000000000000000000000000000
# Minimum delay in seconds between schedule() and execute(). 48h default.
TIMELOCK_MIN_DELAY=172800

# Per-chain timelock addresses — populated AFTER running DeployTimelock
# on each chain. TransferAdminToTimelock reads these to know where to
# hand off ADMIN_ROLE / ERC-173 ownership.
BASE_SEPOLIA_TIMELOCK_ADDRESS=
BASE_TIMELOCK_ADDRESS=
SEPOLIA_TIMELOCK_ADDRESS=
ARB_SEPOLIA_TIMELOCK_ADDRESS=
OP_SEPOLIA_TIMELOCK_ADDRESS=
POLYGON_AMOY_TIMELOCK_ADDRESS=

# Safety gate — TransferAdminToTimelock refuses to broadcast unless
# this is literally the string "YES". Prevents the handover script
# from running by accident against mainnet.
CONFIRM_HANDOVER=NO

# The EOA the keeper bot will sign txs from.
# CRITICAL: this MUST be the public address derived from the
# KEEPER_PRIVATE_KEY secret in the Cloudflare Worker (apps/keeper).
# If they don't match, the deployed FlashLoanLiquidator will reject
# every liquidateViaAaveV3 call with `NotOwner`.
KEEPER_BOT_OWNER=0xD9257B636E17D5714DD54F260c9F7EB81349E49B

# Balancer V2 Vault canonical address. Same on every chain.
BASE_BALANCER_V2_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# Aave V3 Pool address on this chain. From Aave docs.
BASE_AAVE_V3_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# ─── Depth-tiered-LTV — Uni-V2-fork factory addresses ───────────────
#
# `OracleFacet.getLiquidityTier`'s route-search probes V2-fork pools
# alongside the V3 clones for the depth-tier classification. Each
# chain has its own canonical addresses; the script
# `contracts/script/ConfigureV2Factories.s.sol` ships built-in defaults
# (verified against each protocol's docs registry as of 2026-05-14)
# and these env vars are OPTIONAL overrides for the rare case where
# a chain deploys a fork at a non-canonical address. Set to literal
# `0x0000000000000000000000000000000000000000` to leave a leg disabled.
# Bare-keyed values (no chain prefix) are picked up on chains that
# aren't in the script's chainId switch.
#
# Run once per chain:
#   forge script contracts/script/ConfigureV2Factories.s.sol \
#     --rpc-url $VITE_BASE_RPC_URL --broadcast
#
# BASE_UNI_V2_FACTORY=
# BASE_SUSHI_V2_FACTORY=
# BASE_PANCAKE_V2_FACTORY=
# ETH_UNI_V2_FACTORY=
# ARB_UNI_V2_FACTORY=
# OP_SUSHI_V2_FACTORY=
# BNB_PANCAKE_V2_FACTORY=
# POLYGON_SUSHI_V2_FACTORY=

ALCHEMY_API_KEY=<alchemy_api_key>
ALCHEMY_WEBHOOK_AUTH_TOKEN=<alchemy_webhook_auth_token>
