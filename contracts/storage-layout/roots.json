{
  "_readme": "Every storage layout that survives an in-place upgrade (#1274 / #2092). `namespaces` are storage structs at hashed positions (ERC-7201 or keccak256): the Diamond's own, the cross-chain guardian's, and OpenZeppelin's namespaces that the UUPS implementations use. Each names the probe contract in src/storage-layout/StorageLayoutProbes.sol that makes the compiler report the struct, the source file that declares the position, and the constant's name. `uups` are the implementation contracts behind UUPS proxies, whose own state variables are the layout. `pointerExemptions` are files whose `.slot :=` pointers are not namespaces, each with the reason. contracts/script/storage-layout-guard.mjs builds layout.golden.json from these and refuses a tree whose namespaced storage or UUPS contracts are not all listed here.",
  "namespaces": [
    { "id": "vaipakam", "probe": "StorageLayoutProbeVaipakam", "positionFile": "src/libraries/LibVaipakam.sol", "positionConstant": "VANGKI_STORAGE_POSITION" },
    { "id": "erc721", "probe": "StorageLayoutProbeERC721", "positionFile": "src/libraries/LibERC721.sol", "positionConstant": "ERC721_STORAGE_POSITION" },
    { "id": "access-control", "probe": "StorageLayoutProbeAccessControl", "positionFile": "src/libraries/LibAccessControl.sol", "positionConstant": "ACCESS_CONTROL_STORAGE_POSITION" },
    { "id": "pausable", "probe": "StorageLayoutProbePausable", "positionFile": "src/libraries/LibPausable.sol", "positionConstant": "PAUSABLE_STORAGE_POSITION" },
    { "id": "reentrancy-guard", "probe": "StorageLayoutProbeReentrancyGuard", "positionFile": "src/libraries/LibReentrancyGuard.sol", "positionConstant": "REENTRANCY_GUARD_STORAGE_POSITION" },
    { "id": "diamond", "probe": "StorageLayoutProbeDiamond", "positionFile": "lib/diamond-3-hardhat/contracts/libraries/LibDiamond.sol", "positionConstant": "DIAMOND_STORAGE_POSITION" },
    { "id": "guardian", "probe": "StorageLayoutProbeGuardian", "positionFile": "src/crosschain/GuardianPausable.sol", "positionConstant": "GUARDIAN_STORAGE_LOCATION" },
    { "id": "oz-initializable", "probe": "StorageLayoutProbeOzInitializable", "positionFile": "lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/utils/Initializable.sol", "positionConstant": "INITIALIZABLE_STORAGE" },
    { "id": "oz-erc20", "probe": "StorageLayoutProbeOzERC20", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/token/ERC20/ERC20Upgradeable.sol", "positionConstant": "ERC20StorageLocation" },
    { "id": "oz-erc20-capped", "probe": "StorageLayoutProbeOzERC20Capped", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/token/ERC20/extensions/ERC20CappedUpgradeable.sol", "positionConstant": "ERC20CappedStorageLocation" },
    { "id": "oz-erc4626", "probe": "StorageLayoutProbeOzERC4626", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/token/ERC20/extensions/ERC4626Upgradeable.sol", "positionConstant": "ERC4626StorageLocation" },
    { "id": "oz-ownable", "probe": "StorageLayoutProbeOzOwnable", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/access/OwnableUpgradeable.sol", "positionConstant": "OwnableStorageLocation" },
    { "id": "oz-ownable2step", "probe": "StorageLayoutProbeOzOwnable2Step", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/access/Ownable2StepUpgradeable.sol", "positionConstant": "Ownable2StepStorageLocation" },
    { "id": "oz-pausable", "probe": "StorageLayoutProbeOzPausable", "positionFile": "lib/openzeppelin-contracts-upgradeable/contracts/utils/PausableUpgradeable.sol", "positionConstant": "PausableStorageLocation" }
  ],
  "pointerExemptions": [
    { "file": "lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/utils/StorageSlot.sol", "reason": "OpenZeppelin's typed slot accessors (getAddressSlot and its siblings) take the slot as a parameter, so they define no namespace of their own. The slots they are called with here are the EIP-1967 implementation, admin and beacon slots, which the standard fixes; each holds a single value, not a struct layout." }
