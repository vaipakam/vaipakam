{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "Vaipakam vault protection",
    "eip712": {
      "domain": {
        "name": "Vaipakam Vault",
        "version": "1"
      }
    }
  },
  "metadata": {
    "owner": "Vaipakam",
    "info": {
      "url": "https://vaipakam.com"
    },
    "enums": {
      "VaultProtectionBase_REPLACE_": {
        "1": "Propose a new owner",
        "2": "Approve the new owner",
        "3": "Cancel the replacement"
      },
      "VaultProtectionBase_SETTINGS_": {
        "1": "Turn protected mode on",
        "2": "Change the waiting period",
        "3": "Turn protected mode off",
        "4": "Unlock the account"
      },
      "VaultProtectionBase_SIGNER_": {
        "1": "Add a signer",
        "2": "Accept being a signer",
        "3": "Remove a signer",
        "4": "Cancel a signer change"
      }
    }
  },
  "display": {
    "formats": {
      "Settings(uint8 action,uint256 value,uint256 nonce,uint64 expiry)": {
        "$id": "Settings",
        "intent": "Change protected mode",
        "fields": [
          {
            "path": "action",
            "label": "Change",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.VaultProtectionBase_SETTINGS_"
            }
          },
          {
            "path": "value",
            "label": "Waiting period",
            "format": "duration",
            "visible": {
              "ifNotIn": [
                0
              ]
            }
          },
          {
            "path": "nonce",
            "visible": "never"
          },
          {
            "path": "expiry",
            "label": "Signature valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          }
        ]
      },
      "AllowlistAdd(address destination,uint256 nonce,uint64 expiry)": {
        "$id": "AllowlistAdd",
        "intent": "Add a payout destination",
        "fields": [
          {
            "path": "destination",
            "label": "Destination",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            }
          },
          {
            "path": "nonce",
            "visible": "never"
          },
          {
            "path": "expiry",
            "label": "Signature valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          }
        ]
      },
      "AllowlistCancel(address destination,uint256 nonce,uint64 expiry)": {
        "$id": "AllowlistCancel",
