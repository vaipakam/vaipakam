              "mustMatch": [
                "0xBc839c06Ee431d50EA6B087E0f26e80fb022564E",
                "0x2c300b26bc15359E7948dA61a1960303772b0335",
                "0x0EBd0536a698707958e1c327Ba1EB2b4f329A119"
              ]
            }
          },
          {
            "path": "request",
            "label": "Request",
            "format": "raw"
          },
          {
            "path": "nonce",
            "visible": "never"
          },
          {
            "path": "expiry",
            "label": "Signature valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
