          {
            "path": "destination",
            "label": "Destination",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            }
          },
          {
            "path": "nonce",
            "visible": "never"
          },
          {
            "path": "expiry",
            "label": "Signature valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          }
        ]
      },
      "AllowlistRemove(address destination,uint256 nonce,uint64 expiry)": {
