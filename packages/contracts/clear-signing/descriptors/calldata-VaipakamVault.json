  "metadata": {
    "owner": "Vaipakam",
    "info": {
      "url": "https://vaipakam.com"
    },
    "enums": {
      "AssetKind": {
        "0": "Token (ERC-20)",
        "1": "NFT (ERC-721)",
        "2": "NFT (ERC-1155)"
      },
      "VaultProtectionBase_PURPOSE_": {
        "1": "Protected-mode changes",
        "2": "Adding a payout destination",
        "3": "Cancelling or removing a payout destination",
        "4": "Co-signer changes",
        "5": "Owner replacement",
        "6": "Locking the account",
        "7": "Verifying a payout destination",
        "8": "Recovery address changes",
        "9": "Proving control of a recovery address",
        "10": "Moving assets to the recovery address",
        "11": "Moving position NFTs"
      },
      "VaultProtectionBase_REPLACE_": {
        "1": "Propose a new owner",
        "2": "Approve the new owner",
        "3": "Cancel the replacement"
      },
      "VaultProtectionBase_SETTINGS_": {
        "1": "Turn protected mode on",
        "2": "Change the waiting period",
        "3": "Turn protected mode off",
        "4": "Unlock the account"
      },
      "VaultProtectionBase_SIGNER_": {
        "1": "Add a signer",
        "2": "Accept being a signer",
        "3": "Remove a signer",
        "4": "Cancel a signer change"
      }
    }
  },
  "display": {
    "formats": {
      "protect(bytes data)": {
        "$id": "VaipakamVaultImplementation.protect",
        "intent": "Change your account protection",
        "fields": [
          {
            "path": "data",
            "label": "Change",
            "format": "calldata",
            "params": {
              "calleePath": "@.to"
            }
          }
        ]
      },
      "addAllowlisted(address destination,(address key,uint64 expiry,bytes sig) auth)": {
        "$id": "VaultProtection.addAllowlisted",
        "intent": "Add a payout destination",
        "fields": [
          {
            "path": "destination",
            "label": "Destination",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            }
          },
          {
            "path": "auth.key",
            "label": "Acting key",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            }
          },
          {
            "path": "auth.expiry",
            "label": "Signature valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": {
              "ifNotIn": [
                0
              ]
            }
          },
          {
            "path": "auth.sig",
            "visible": "never"
          }
        ]
      },
