# Sanctions adder settings for ONE chain. Install as
#   /etc/vaipakam/sanctions-adder/<chain-slug>.env   (root:root, mode 0600)
# and fill in. An empty value means unset. Read by
# packages/contracts/scripts/sanctions-adder.mjs; its header documents each.

# RPC for the list's chain. Carries an API key: keep this file root-only.
SANCTIONS_ADDER_RPC_URL=
# The chain's id, checked against what the RPC serves. Testnets only
# (84532 Base Sepolia, 421614 Arbitrum Sepolia, ...) until a hardened
# mainnet host is decided (#2443).
SANCTIONS_ADDER_CHAIN_ID=
# The SanctionsList this run updates (DeploySanctionsList records it as
# `sanctionsList` in the chain's deployment artifact).
SANCTIONS_LIST_ADDRESS=
# The ADDER key: appointed with setAdder, never the owner, never a remover,
# never the keeper's key. It needs only gas.
SANCTIONS_ADDER_PRIVATE_KEY=

# Optional.
SANCTIONS_ADDER_KEEP_FILES=14
SANCTIONS_ADDER_MAX_REMOVE=10
# The ops-internal Telegram bot (never the user-facing TG_BOT_TOKEN). Unset:
# runs report to the journal only.
TG_OPS_BOT_TOKEN=
TG_OPS_CHAT_ID=
