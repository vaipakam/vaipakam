{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaipakam-mesh-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // ── keep_vars: the dashboard's plain-text vars survive a deploy ──
  //
  // Wrangler DELETES every var not present in this file before setting the
  // ones that are, so any value managed only in the dashboard is wiped by an
  // ordinary `wrangler deploy`. That is the hazard `--keep-vars` was being
  // added by hand at every call site to avoid — across runbooks, deploy
  // scripts, workflows and package scripts — which is an unbounded set of
  // spellings to keep correct, and #1995 spent 242 review findings proving it.
  //
  // Set HERE instead, the preservation is a property of the WORKER rather than
  // of each invocation: wrangler reads `config.keep_vars` on both the deploy
  // path and `versions upload`, so every spelling becomes safe at once,
  // including the ones nobody has written yet.
  //
  // Declared vars are still uploaded normally — this only suppresses the
  // DELETE of bindings absent from the config (wire field
  // `keep_bindings: ["plain_text","json"]`). Secrets were never at risk;
  // wrangler keeps those unconditionally.
  //
  // CONSEQUENCE, and it is the intended trade: a deploy can no longer REMOVE
  // a var. Deleting one is now a deliberate dashboard action.
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
  // Cron — every 5 minutes, ONE chain per tick.
  //
  // The checks are detection-only: nothing here moves funds or pauses a
  // contract, and the invariants it watches change at day-close cadence,
  // not per block. Each tick reads Base plus ONE chain of the rotation
  // (canonical first, then `getExpectedSourceChainIds()` ascending — see
  // `src/rotation.ts`), because reading the whole mesh in one invocation
  // went past the Workers Free cap of 50 subrequests. At three chains each
  // chain is read every 15 minutes, which is what the tick-counted windows
  // below are sized for. `ROTATION_STEP_SECONDS` must equal this interval.
  // This slot is the one freed by retiring `vaipakam-lz-watcher`, whose
  // LayerZero surface the T-068 CCIP migration and the #687-A securities
  // excision had between them made entirely dead.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // D1 — windowed-advisory streak state + alert repeat suppression.
  //
  // SEPARATE database from the shared `vaipakam-warm` that
  // apps/{indexer,keeper,agent} bind to, for the same trust-boundary
  // reason `ops/lz-watcher` had its own: this Worker is internal ops
  // only, and co-locating its alerting bookkeeping with user-facing
  // data conflates two different audit trails. The consequence is that
  // CLAUDE.md's "all schema changes land under apps/indexer/migrations"
  // rule does not apply here — that rule owns the shared archive, and
  // `migrations/` in this directory owns this database.
  //
  // Created 2026-11-04 (`wrangler d1 create vaipakam-mesh-alerts-db`) and
  // migrated with `npm run db:migrate`. A later migration applies the same way.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaipakam-mesh-alerts-db",
      "database_id": "b356a675-9739-4097-8705-47e01615c9f3",
      "remote": false,
    },
  ],
  // ── Credentials ──────────────────────────────────────────────────
  //
  // The ops bot pair and the RPC URLs are bound from the account Secrets
  // Store `vaipakam-credentials` (below), the same copies the keeper,
  // indexer and agent read, so nothing is held twice. `src/env.ts`
  // `resolveEnv` reads them once per invocation. Set or rotate them with
  // `wrangler secrets-store secret update`, NEVER `wrangler secret put`: a
  // per-Worker secret of the same name cannot coexist with the binding.
  //
  // The one per-Worker secret (set via `wrangler secret put`, never
  // committed):
  //   WATCHER_RUN_TOKEN — bearer token for the manual `POST /run`
  //                      trigger. REQUIRED to use that endpoint at all:
  //                      while it is unset the endpoint returns 401 and
  //                      only the cron can drive a tick. A tick is not a
  //                      read-only probe (it burns RPC quota, advances
  //                      the streak counters and sends Telegram) and a
  //                      workers.dev URL is public, so the endpoint is
  //                      fail-CLOSED. `openssl rand -hex 32`.
  //
  // Store-bound:
  //   TG_OPS_BOT_TOKEN — the OPS-internal Telegram bot. DELIBERATELY NOT
  //                      `TG_BOT_TOKEN`, which is the user-facing bot
  //                      apps/keeper + apps/agent post with. See
  //                      CLAUDE.md, "Two Telegram bots".
  //   TG_OPS_CHAT_ID   — numeric chat id of the internal ops channel. Not
  //                      a credential (a chat id grants nothing without
  //                      the token), but it lives beside the token so the
  //                      pair has one home.
  //   RPC_<chainId>    — one per reward chain, keyed by EVM chain id and
  //                      bound to the store's slug-named secret. A mirror
  //                      newly wired into `getExpectedSourceChainIds()`
  //                      needs one more binding here. A chain with no RPC
  //                      bound is reported as a COVERAGE GAP, never
  //                      silently skipped.
  "secrets_store_secrets": [
    { "binding": "TG_OPS_BOT_TOKEN", "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e", "secret_name": "TG_OPS_BOT_TOKEN" },
    { "binding": "TG_OPS_CHAT_ID",   "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e", "secret_name": "TG_OPS_CHAT_ID" },
    { "binding": "RPC_84532",        "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e", "secret_name": "RPC_BASE_SEPOLIA" },
    { "binding": "RPC_421614",       "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e", "secret_name": "RPC_ARB_SEPOLIA" },
    { "binding": "RPC_97",           "store_id": "1e66429d0fa24aa38a27bc05b7bcf63e", "secret_name": "RPC_BNB_TESTNET" },
  ],
  "vars": {
    // EVM chain id of the canonical REWARD chain (Base 8453 / Base
    // Sepolia 84532). The MIRROR set is deliberately NOT configured
    // here: it is read from the canonical Diamond's
    // `getExpectedSourceChainIds()` every tick, so the watcher's scope
    // follows the on-chain wiring rather than a second list that can
    // drift from it.
    "CANONICAL_CHAIN_ID": "84532",

    // ── Windowed-advisory tuning ────────────────────────────────────
    // Consecutive observations OF ONE CHAIN a condition must hold,
    // unchanged, before its advisory fires. A chain is observed once per
    // rotation: (chains in the mesh) x ROTATION_STEP_SECONDS = 3 x 5min =
    // 15min today. Wiring a fourth chain makes that 20 minutes and
    // lengthens both windows by a third — the safe direction (later, never
    // spurious), but RETUNE them then.
    //
    // Stuck settlement: 6 x 15min = 1.5h of uninterrupted stasis. Fine at
    // this size because retirement is read from the CHAIN'S OWN ledger,
    // which moves the instant it settles anything — no report cycle sits
    // between the event and the observation.
    "STUCK_WINDOW_TICKS": "6",

    // Report lag: MUCH larger, and deliberately so. Those cumulatives
    // travel only in the chain's DAY-CLOSE report, so between reports
    // Base is legitimately behind and frozen for a whole day — a window
    // shorter than one report cycle makes a perfectly healthy chain alarm
    // daily. Floor = day (86400s) + finalization grace (14400s) + CCIP
    // delivery, over the per-chain cycle: ~112 observations at 15 minutes. 130 is
    // ~32.5h. RETUNE IF YOU CHANGE THE CRON above or the chain count.
    "REPORT_LAG_WINDOW_TICKS": "130",

    // Slack on the bucket-coverage check, in VPFI wei. Non-zero on
    // purpose: `LibVpfiRecycle.consume` floors the bucket at zero rather
    // than reverting, because bounded cap-trim dust can make a day's
    // consumption exceed its recorded commitment by wei-scale amounts,
    // so an exact comparison would fire on healthy rounding. 1e15 =
    // 0.001 VPFI — far above that dust, far below any real shortfall.
    "BUCKET_COVERAGE_TOLERANCE_WEI": "1000000000000000",

    // Slack on the REVERSE composition bound ONLY (#1448). Deliberately a
    // SEPARATE knob from the coverage tolerance above: `consume`'s bucket
    // floor widens exactly this direction, so raising the coverage value for
    // a chain with noisy dust would otherwise silently widen a
    // custody-exclusion blind spot the operator has no reason to connect to
    // it. Same default; tune independently.
    "COMPOSITION_SLACK_TOLERANCE_WEI": "1000000000000000",

    // Seconds before an unchanged, still-firing alert is reposted.
    "ALERT_REPEAT_SECONDS": "21600",

    // How old a chain's latest block may be before its snapshot is
    // treated as UNREADABLE rather than compared against Base. Load-
    // balanced RPC fleets routinely serve a slightly stale head, and when
    // they do Base legitimately holds newer figures than the snapshot —
    // which the cross-chain checks would otherwise report as ledger
    // corruption. 300s sits well above ordinary head lag and clock skew,
    // and well below both the 15-minute per-chain cycle and the day-close cadence.
    // Raise it only for a chain that genuinely idles between blocks.
    "STALE_LOCAL_SECONDS": "300",

    // Seconds between cron ticks — MUST equal the cron interval above. The
    // tick's chain is (scheduled time / this) mod the rotation length, so a
    // mismatch skips or doubles chains.
    "ROTATION_STEP_SECONDS": "300",
  },
}
