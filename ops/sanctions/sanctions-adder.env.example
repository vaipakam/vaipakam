# Sanctions adder settings: ONE file for every chain, like the keeper's.
# install.sh creates it as /etc/vaipakam/sanctions-adder.env (root:root, mode
# 0600) if it does not exist, and never overwrites it. Fill it in on the
# machine with `sudoedit`. An empty value means unset. Read by
# packages/contracts/scripts/sanctions-adder.mjs; its header documents each.

# The ADDER key: appointed with setAdder on each chain's list, never the
# owner, never a remover, never the keeper's key. It needs only gas, on every
# chain below that has an RPC. 64 hex digits, with or without the 0x prefix,
# as keeper.env accepts its key.
SANCTIONS_ADDER_PRIVATE_KEY=

# One RPC per chain to update, under the keeper's names (each carries an API
# key). A chain with no RPC is not touched. The list address is NOT set here:
# it comes from the `sanctionsList` this release's deployments.json records,
# and a chain with an RPC but no recorded list is reported as skipped.
# Testnets only until a hardened mainnet host is decided (#2443); mainnet
# names (RPC_BASE, RPC_ETH, ...) are ignored if present.
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_SEPOLIA=
RPC_OP_SEPOLIA=
RPC_BNB_TESTNET=

# Optional.
SANCTIONS_ADDER_KEEP_FILES=14
SANCTIONS_ADDER_MAX_REMOVE=10
# The ops-internal Telegram bot (never the user-facing TG_BOT_TOKEN). Unset:
# runs report to the journal only.
TG_OPS_BOT_TOKEN=
TG_OPS_CHAT_ID=
