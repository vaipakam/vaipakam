# Sanctions delister settings: ONE file for every chain, like the adder's and
# the keeper's (#2443). install.sh creates it from this template only when it
# does not exist, and never overwrites it. Fill it in on the machine with
# `sudoedit`. An empty value means unset.

# The DELISTER key: appointed with setProposer on each chain's
# SanctionsDelistingTimelock. Never the adder's, the keeper's, the owner's or
# the Safe's key, and never a remover of the list. It needs gas on every chain
# below that has an RPC; on a cross-chain RedStone route it also pays the CCIP
# fees for the clearance request and its reply.
SANCTIONS_DELISTER_PRIVATE_KEY=

# One RPC per chain, under the keeper's names (each carries an API key). A
# chain with no RPC is not touched. The timelock and list addresses are NOT set
# here: they come from the installed release's deployments.json. A cross-chain
# route also needs the RPC of the chain its attestor runs on. Testnets only
# until a hardened mainnet host is decided (#2443).
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_SEPOLIA=
RPC_OP_SEPOLIA=
RPC_BNB_TESTNET=

# Optional. The ops-internal Telegram bot (never the user-facing
# TG_BOT_TOKEN). Unset: runs report to the journal only.
TG_OPS_BOT_TOKEN=
TG_OPS_CHAT_ID=
