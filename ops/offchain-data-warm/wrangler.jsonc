{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaipakam-offchain-data-warm",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],

  // ── keep_vars: the dashboard's plain-text vars survive a deploy ──
  //
  // Wrangler DELETES every var not present in this file before setting the
  // ones that are, so any value managed only in the dashboard is wiped by an
  // ordinary `wrangler deploy`. That is the hazard `--keep-vars` was being
  // added by hand at every call site to avoid — across runbooks, deploy
  // scripts, workflows and package scripts — which is an unbounded set of
  // spellings to keep correct, and #1995 spent 242 review findings proving it.
  //
  // Set HERE instead, the preservation is a property of the WORKER rather than
  // of each invocation: wrangler reads `config.keep_vars` on both the deploy
  // path and `versions upload`, so every spelling becomes safe at once,
  // including the ones nobody has written yet.
  //
  // Declared vars are still uploaded normally — this only suppresses the
  // DELETE of bindings absent from the config (wire field
  // `keep_bindings: ["plain_text","json"]`). Secrets were never at risk;
  // wrangler keeps those unconditionally.
  //
  // CONSEQUENCE, and it is the intended trade: a deploy can no longer REMOVE
  // a var. Deleting one is now a deliberate dashboard action.
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
  // Triggers: ONE cron per day at 03:17 UTC (off-peak across UTC /
  // IST / PT). The minute is non-zero on purpose so the run doesn't
  // collide with every other team-on-the-internet's :00 crons
  // fighting for B2's incoming HTTP capacity at exact-minute marks.
  //
  // The cron runs the nightly backup and nothing else. The Monday
  // healthcheck that used to share this tick was removed with the read
  // key and the symmetric decryption key it needed (#1463, #1469); the
  // backup watcher (.github/workflows/backup-ledger.yml) makes its checks
  // every day from outside Cloudflare.
  //
  // The free plan caps cron triggers per account, and this Worker takes
  // one. How much of that budget is spoken for is NOT stated here: it
  // was, for a long time, and it was wrong — the arithmetic in this
  // comment omitted `vaipakam-offchain-data-archive`, this Worker's own
  // predecessor, which has no source in this repository and is therefore
  // invisible to anyone counting `crons` entries across the tree (#1977).
  // `docs/ops/CloudflareCronSlots.md` carries both the count and the status,
  // once, with the date they were last checked against the account.
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  // D1 — read-only bindings to the two production databases this
  // Worker backs up. The shared vaipakam-warm holds the indexer
  // tables + the diag / legal-hold registers. (vaipakam-lz-alerts-db
  // was the lz-watcher's separate alerts DB, kept distinct from
  // vaipakam-warm for the trust-boundary reasons documented in
  // CLAUDE.md's D1-schema-discipline section).
  //
  // The Worker NEVER writes to either DB; the bindings are present
  // only so the cron can SELECT rows for export. We deliberately
  // don't add a third D1 for backup bookkeeping (last-run-id,
  // success/failure log) — that lives in `wrangler tail`, the nightly
  // ops message and the backup watcher's ledger, outside this Worker.
  "d1_databases": [
    {
      "binding": "DB_ARCHIVE",
      "database_name": "vaipakam-warm",
      "database_id": "e5e927cf-56c3-42c7-9820-179a235cc84f",
      "remote": false,
    },
    // #1440 — the DB_LZ_ALERTS binding to `vaipakam-lz-alerts-db` was
    // removed here. The `vaipakam-lz-watcher` Worker was deleted on
    // 2026-07-28 (post-T-068 it polled a decommissioned LayerZero stack,
    // including the VpfiBuyAdapter surface the #687-A excision removed), so
    // its database holds only alert-dedup state and block cursors for a
    // dead transport. This binding was its last consumer.
    //
    // ORDER MATTERS: this removal ships and runs one clean nightly BEFORE
    // the D1 itself is deleted — dropping the database first would have
    // broken the backup, and quietly, at 03:17.
  ],
  // R2 — read-only binding to the legal-vault. The Worker streams
  // every object out and re-uploads to B2; no writes back to R2.
  "r2_buckets": [
    {
      "binding": "R2_LEGAL_VAULT",
      "bucket_name": "vaipakam-legal-vault",
    },
  ],
  // Secrets live in `wrangler secret put`:
  //   B2_WRITE_ACCESS_KEY_ID       — Application Key id, scoped
  //                                  write-only to the backup bucket
  //                                  (listBuckets + writeFiles — NOT
  //                                  listFiles; #1450 r27). The ONLY
  //                                  B2 key this Worker holds: it
  //                                  cannot list, read or delete an
  //                                  archive, so it cannot learn an
  //                                  existing archive's name, and the
  //                                  random nonce in each name is what
  //                                  keeps a leaked key from
  //                                  overwriting it.
  //   B2_WRITE_SECRET_ACCESS_KEY   — matching secret of above.
  //   TG_OPS_BOT_TOKEN             — Telegram bot dedicated to
  //                                  internal-ops alerts. DELIBERATELY
  //                                  DISTINCT from `TG_BOT_TOKEN`,
  //                                  the user-facing bot used by
  //                                  apps/keeper + apps/agent, so a
  //                                  leak of either cannot reach the
  //                                  other's channels. Nightly backup
  //                                  outcomes go to TG_OPS_CHAT_ID.
  //
  // There is NO encryption secret. Each archive is encrypted to the
  // recipient PUBLIC keys committed in backup-recipients/recipients.json
  // and bundled at build time; the private keys are offline and never
  // reach Cloudflare (#1463). The read key (B2_READ_*) and the symmetric
  // BACKUP_ENCRYPTION_KEY were removed with the healthcheck; deleting them
  // from the deployed Worker is an owner step, because a deploy does not
  // remove a secret.
  //
  // All three of B2_ENDPOINT, B2_BUCKET, and TG_OPS_CHAT_ID are
  // operator-configured via `wrangler secret put` rather than baked
  // into this JSONC file. Reasons:
  //   - B2_ENDPOINT is account-region-specific. The
  //     `scripts/setup-backblaze.mjs` setup script discovers the
  //     account's S3 endpoint from `b2_authorize_account`'s response
  //     and prints it. Hard-coding one operator's region here would
  //     silently break signed B2 calls for any fork / re-deploy on
  //     a different account whose bucket lives in a different
  //     region.
  //   - B2_BUCKET names are globally unique across all B2 accounts.
  //     A fork can't reuse "vaipakam-offchain-data-warm" — they
  //     need their own bucket name.
  //   - TG_OPS_CHAT_ID isn't strictly secret (chat ids grant
  //     nothing without the bot token) but lifting it out of the
  //     public repo avoids revealing which channel ops alerts land
  //     in. Free-of-cost obfuscation.
  // Workers reads `env.X` identically for vars and secrets — no
  // Worker code change is needed.
  //
  // No plain vars. `ARCHIVE_FIRST_MONTHLY` / `ARCHIVE_FIRST_YEARLY` (the
  // first monthly and yearly cut, declared because they cannot be inferred
  // from what survived, #1476) moved to the backup watcher with the
  // healthcheck that read them: .github/workflows/backup-ledger.yml now
  // carries the one committed copy. Because `keep_vars` is set, removing the
  // var here does not remove it from the deployed Worker; the Worker no
  // longer reads it, and deleting it there is an owner step.
}
